{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wortins",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat gives us node:crypto, which signs the Google service-account
  // JWTs in lib/gsc.ts and lib/ga.ts. There is deliberately no filesystem use
  // left to support — blog content is bundled at build time.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backs the incremental cache: prerendered pages are served from here, and
  // ISR revalidations are written back. KV is a STOPGAP — R2 is the design
  // choice (see open-next.config.ts) but R2 needs dashboard enablement on this
  // account. KV free tier allows 1,000 writes/day, which today's traffic stays
  // inside; swap back to r2_buckets + r2IncrementalCache once R2 is enabled.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0ec7a6caf10443b9a9cfd718bc7dff9a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
